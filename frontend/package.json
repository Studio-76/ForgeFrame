{
  "name": "forgeframe-frontend",
  "version": "0.2.0",
  "private": true,
  "description": "ForgeFrame control-plane frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "build": "vite build && node scripts/docs-if-changed.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "docs": "typedoc",
    "docs:if-changed": "node scripts/docs-if-changed.mjs",
    "docs:watch": "typedoc --watch"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.7",
    "@tanstack/react-table": "^8.21.3",
    "react": "^19.1.1",
    "react-aria": "^3.48.0",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "react-stately": "^3.46.0",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^29.0.2",
    "typedoc": "^0.28.19",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
